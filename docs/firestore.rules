rules_version = '2';
// 던전 보스 레이드 — 둘이서 하기(Firestore) 보안 규칙
// 붙여넣는 곳: Firebase 콘솔 → Firestore Database → "규칙" 탭 → 전부 지우고 이 내용 붙여넣기 → "게시"
// 뜻: 로그인(익명)한 사람만 방을 읽고, 방에 들어온 두 사람(b 보스, h 용사)만 그 방을 고칠 수 있음.
//     빈자리에는 자기 자신만 앉을 수 있고, 남의 자리는 못 바꿈. 방 삭제는 불가. 상태 글자는 최대 약 900KB.
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['b', 'h', 's'])
        && request.resource.data.s is string && request.resource.data.s.size() < 900000
        && (request.resource.data.b == request.auth.uid || request.resource.data.h == request.auth.uid);
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['b', 'h', 's'])
        && request.resource.data.s is string && request.resource.data.s.size() < 900000
        && (
          ((resource.data.b == request.auth.uid || resource.data.h == request.auth.uid)
            && request.resource.data.b == resource.data.b && request.resource.data.h == resource.data.h)
          || (resource.data.b == "" && request.resource.data.b == request.auth.uid && request.resource.data.h == resource.data.h)
          || (resource.data.h == "" && request.resource.data.h == request.auth.uid && request.resource.data.b == resource.data.b)
        );
      allow delete: if false;
    }
  }
}
